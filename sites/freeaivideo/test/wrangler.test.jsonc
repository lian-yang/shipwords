// Test only: isolated in-memory D1 and R2, never deployed.
{
  "name": "freeaivideo-signup-trial-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ADMIN_EMAIL": "admin@example.test", "YIR_API_KEY": "test-only-key" },
  "workflows": [{ "name": "test-generation", "binding": "GENERATION_WORKFLOW", "class_name": "TestWorkflow" }],
  "d1_databases": [{ "binding": "DB", "database_name": "test", "database_id": "local" }],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "test-outputs" }]
}
