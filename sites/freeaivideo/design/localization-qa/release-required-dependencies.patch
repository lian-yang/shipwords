+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { getTurnstileToken } from '../src/turnstile';
+
+type WidgetOptions = {
+  callback: (token: string) => void;
+  'error-callback': () => void;
+  'expired-callback': () => void;
+};
+type Script = { onload?: () => void; onerror?: () => void };
+
+let widgets: WidgetOptions[];
+let render: ReturnType<typeof vi.fn<(element: HTMLElement, options: WidgetOptions) => string>>;
+let remove: ReturnType<typeof vi.fn<(id: string) => void>>;
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  widgets = [];
+  render = vi.fn((_element: HTMLElement, options: WidgetOptions) => {
+    widgets.push(options);
+    return `widget-${widgets.length}`;
+  });
+  remove = vi.fn<(id: string) => void>();
+  const container = { innerHTML: '' };
+  vi.stubGlobal('document', {
+    getElementById: () => container,
+    createElement: () => ({}),
+    head: { appendChild: (script: Script) => script.onload?.() },
+  });
+  vi.stubGlobal('window', { turnstile: { render, remove } });
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+describe('Turnstile widget lifetime', () => {
+  it('removes each successful widget and obtains a fresh token on another submission', async () => {
+    const first = getTurnstileToken('site-key');
+    await Promise.resolve();
+    widgets[0]!.callback('first-token');
+    await expect(first).resolves.toBe('first-token');
+    expect(remove).toHaveBeenCalledWith('widget-1');
+
+    const second = getTurnstileToken('site-key');
+    await Promise.resolve();
+    widgets[1]!.callback('second-token');
+    await expect(second).resolves.toBe('second-token');
+    expect(remove.mock.calls).toEqual([['widget-1'], ['widget-2']]);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it.each([
+    ['error-callback', 'turnstile_failed'],
+    ['expired-callback', 'turnstile_expired'],
+  ] as const)('cleans up after %s and permits a later submission', async (callback, message) => {
+    const failed = getTurnstileToken('site-key');
+    await Promise.resolve();
+    widgets[0]![callback]();
+    await expect(failed).rejects.toThrow(message);
+    expect(remove).toHaveBeenCalledWith('widget-1');
+    expect(vi.getTimerCount()).toBe(0);
+
+    const retry = getTurnstileToken('site-key');
+    await Promise.resolve();
+    widgets[1]!.callback('retry-token');
+    await expect(retry).resolves.toBe('retry-token');
+    expect(remove.mock.calls).toEqual([['widget-1'], ['widget-2']]);
+  });
+
+  it('removes a timed-out widget and ignores any late callbacks', async () => {
+    const pending = getTurnstileToken('site-key');
+    await Promise.resolve();
+    const rejected = expect(pending).rejects.toThrow('turnstile_timeout');
+    await vi.advanceTimersByTimeAsync(45000);
+    await rejected;
+    expect(remove).toHaveBeenCalledExactlyOnceWith('widget-1');
+    widgets[0]!.callback('too-late');
+    widgets[0]!['expired-callback']();
+    expect(remove).toHaveBeenCalledTimes(1);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('removes the returned ID when success fires synchronously inside render', async () => {
+    render.mockImplementation((_element, options) => {
+      options.callback('sync-token');
+      return 'sync-widget';
+    });
+    await expect(getTurnstileToken('site-key')).resolves.toBe('sync-token');
+    expect(remove).toHaveBeenCalledExactlyOnceWith('sync-widget');
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('removes the returned ID when an error fires synchronously inside render', async () => {
+    render.mockImplementation((_element, options) => {
+      options['error-callback']();
+      return 'sync-widget';
+    });
+    await expect(getTurnstileToken('site-key')).rejects.toThrow('turnstile_failed');
+    expect(remove).toHaveBeenCalledExactlyOnceWith('sync-widget');
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('clears its timer when render throws before a widget ID is returned', async () => {
+    render.mockImplementation(() => {
+      throw new Error('render failed');
+    });
+    await expect(getTurnstileToken('site-key')).rejects.toThrow('render failed');
+    expect(remove).not.toHaveBeenCalled();
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('does not lose a token if the SDK already removed the widget', async () => {
+    remove.mockImplementation(() => {
+      throw new Error('already removed');
+    });
+    const pending = getTurnstileToken('site-key');
+    await Promise.resolve();
+    widgets[0]!.callback('valid-token');
+    await expect(pending).resolves.toBe('valid-token');
+    expect(remove).toHaveBeenCalledTimes(1);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+});
