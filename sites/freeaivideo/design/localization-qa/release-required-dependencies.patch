+// Cloudflare Turnstile client side: load the widget script once, render a fresh widget per submit,
+// and resolve with the token. `appearance: 'interaction-only'` keeps the widget invisible unless a
+// challenge actually needs input.
+
+const SCRIPT_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
+export const TURNSTILE_CONTAINER_ID = 'turnstile-slot';
+
+let loading: Promise<void> | null = null;
+
+function loadScript(): Promise<void> {
+  loading ??= new Promise((resolve, reject) => {
+    const script = document.createElement('script');
+    script.src = SCRIPT_SRC;
+    script.async = true;
+    script.onload = () => resolve();
+    script.onerror = () => {
+      loading = null;
+      reject(new Error('turnstile_script_failed'));
+    };
+    document.head.appendChild(script);
+  });
+  return loading;
+}
+
+interface TurnstileApi {
+  render: (el: HTMLElement, options: Record<string, unknown>) => string;
+  remove: (widgetId: string) => void;
+}
+
+function api(): TurnstileApi {
+  return (window as unknown as { turnstile: TurnstileApi }).turnstile;
+}
+
+export async function getTurnstileToken(siteKey: string): Promise<string> {
+  await loadScript();
+  const container = document.getElementById(TURNSTILE_CONTAINER_ID);
+  if (!container) throw new Error('turnstile_container_missing');
+  container.innerHTML = '';
+  return new Promise((resolve, reject) => {
+    const turnstile = api();
+    let widgetId: string | undefined;
+    let settled = false;
+    let removed = false;
+    const cleanup = () => {
+      clearTimeout(timer);
+      if (widgetId === undefined || removed) return;
+      removed = true;
+      try {
+        turnstile.remove(widgetId);
+      } catch {
+        // Navigation or the SDK may have already removed it; cleanup must not hide the result.
+      }
+    };
+    const settle = (result: { token: string } | { error: Error }) => {
+      if (settled) return;
+      settled = true;
+      cleanup();
+      if ('error' in result) reject(result.error);
+      else resolve(result.token);
+    };
+    const timer = setTimeout(() => settle({ error: new Error('turnstile_timeout') }), 45000);
+    try {
+      widgetId = turnstile.render(container, {
+        sitekey: siteKey,
+        appearance: 'interaction-only',
+        theme: 'dark',
+        callback: (token: string) => settle({ token }),
+        'error-callback': () => settle({ error: new Error('turnstile_failed') }),
+        'expired-callback': () => settle({ error: new Error('turnstile_expired') }),
+      });
+      // A synchronous SDK callback can settle before render returns its ID.
+      if (settled) cleanup();
+    } catch (e) {
+      settle({ error: e instanceof Error ? e : new Error('turnstile_render_failed') });
+    }
+  });
+}
